# Copy to .env and adjust. All values have development defaults (see app/config.py).
ENV=development
DATABASE_URL=postgresql+asyncpg://vlack:vlack@127.0.0.1:5432/vlack_hrms
REDIS_URL=redis://127.0.0.1:6379/0
# REQUIRED in production — a long random string:
JWT_SECRET=dev-only-secret-change-me-before-going-live
HOSPITAL_NAME=Vlack Multispecialty Hospital
TIMEZONE=Asia/Kolkata
# Optional: enables LLM drafting in the AI Engine (otherwise deterministic templates are used)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
DISCOUNT_APPROVAL_PERCENT=10
NOTIFY_MODE=log
AUTO_MIGRATE=true

# Demo accounts created by `python -m app.seed` all share this password (development only):
#   admin, ceo, cfo, dr.rao, dr.lakshmi, nurse.priya, frontdesk, billing, pharmacy, lab,
#   radiology, hr, stores, quality, support, marketing, employee
DEMO_PASSWORD=Vlack@2026
